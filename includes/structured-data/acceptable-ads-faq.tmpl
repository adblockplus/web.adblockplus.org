{% set opt_out -%}
<p>{{ t("hate-ads-1", "You can disable this feature at any time:") }}</p>
{%- for key, name, steps in products %}
<h4>{{ t(key, name) }}</h4>
<ol>{% for step_key, step in steps %}<li>{{ t(step_key, step) }}</li>{% endfor %}</ol>
